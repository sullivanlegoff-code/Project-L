{
  "name": "prairie-lapins-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:lab": "tsc --noEmit && vite build --mode laboratory",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:account-preview": "tsc --noEmit && vite build --mode account-preview --base=/Project-L/preview/accounts/"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "phaser": "3.90.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
